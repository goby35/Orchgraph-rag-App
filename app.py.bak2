# --- Neo4j connection check ---

def check_neo4j_connection() -> Tuple[bool, Dict[str, Any]]:
    """Check Neo4j and return (connected, stats_dict)."""
    if settings is None:
        return False, {"nodes": 0, "rels": 0, "error": "settings not loaded"}
    try:
        from neo4j import GraphDatabase
        driver = GraphDatabase.driver(
            settings.NEO4J_URI,
            auth=(settings.NEO4J_USER, settings.NEO4J_PASSWORD),
        )
        with driver.session() as session:
            nodes = session.run("MATCH (n) RETURN count(n) AS c").single()["c"]
            rels = session.run("MATCH ()-[r]->() RETURN count(r) AS c").single()["c"]
        driver.close()
        return True, {"nodes": nodes, "rels": rels}
    except Exception as exc:
        return False, {"nodes": 0, "rels": 0, "error": str(exc)}


# Run once per session
if "neo4j_checked" not in st.session_state:
    ok, stats = check_neo4j_connection()
    st.session_state.neo4j_stats = {"connected": ok, **stats}
    st.session_state.neo4j_checked = True


# ── UTILITY FUNCTIONS ═════════════════════════════════════════

def _esc(text: str) -> str:
    """HTML-escape user generated text to prevent XSS."""
    return html.escape(str(text))


def _badge(text: str, variant: str = "cyan") -> str:
    return f'<span class="badge badge-{variant}">{_esc(text)}</span>'


def _extract_citations(answer: str) -> Tuple[str, List[Dict[str, str]]]:
    """Replace [VEC:…] / [GRF:…] markers with numbered superscripts."""
    footnotes: List[Dict[str, str]] = []
    seen: Dict[str, int] = {}

    def _repl(m: re.Match) -> str:
        ctype, ref = m.group(1), m.group(2).strip()
        key = f"{ctype}|{ref}"
        if key in seen:
            idx = seen[key]
        else:
            idx = len(footnotes) + 1
            seen[key] = idx
            footnotes.append({"idx": str(idx), "type": ctype, "ref": ref})
        return f"<sup>[{idx}]</sup>"

    cleaned = _CITATION_RE.sub(_repl, answer)
    return cleaned, footnotes


def _build_vec_sources(records: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    """Extract VEC-style source list from hybrid_ask records."""
    sources: List[Dict[str, Any]] = []
    for rec in records:
        sources.append({
            "chunk_id": rec.get("chunk_id", ""),
            "source_file": rec.get("source_file", ""),
            "score": rec.get("score", 0.0),
            "text": (rec.get("text", "") or "")[:200],
            "chunk_index": rec.get("chunk_index", 0),
        })
    return sources


def _build_grf_sources(records: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
    """Extract unique GRF triplet sources from hybrid_ask records."""
    seen: set = set()
    sources: List[Dict[str, Any]] = []
    for rec in records:
        for t in rec.get("triplets", []):
            subj = t.get("subject", "")
            action = t.get("action", "")
            obj = t.get("object", "")
            if not subj or not obj:
                continue
            key = f"{subj}|{action}|{obj}"
            if key in seen:
                continue
            seen.add(key)
            sources.append({
                "entity": subj,
                "relation": action,
                "object": obj,
                "chunk_id": rec.get("chunk_id", ""),
            })
    return sources


def _refresh_neo4j_stats() -> None:
    """Re-check Neo4j and update session state."""
    ok, stats = check_neo4j_connection()
    st.session_state.neo4j_stats = {"connected": ok, **stats}


