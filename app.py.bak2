# ── MODULE 2: ADMIN ───────────────────────────────────────────

def _stepper_html(steps: Dict[str, Dict]) -> str:
    """Generate full pipeline stepper HTML from session state."""
    parts: List[str] = []
    for icon, name in _PIPELINE_STEPS:
        info = steps.get(name, {"status": "waiting", "duration": None})
        status = info["status"]
        dur = info.get("duration")
        dur_str = f"{dur:.1f}s" if dur is not None else ""

        state_cls = f"step-{status}"
        icon_map = {"waiting": "⏳", "running": "⟳", "done": "✓", "error": "✗"}
        badge_map = {
            "waiting": _badge("Chờ", "gray"),
            "running": _badge("Đang chạy", "cyan"),
            "done":    _badge("Hoàn tất", "emerald"),
            "error":   _badge("Lỗi", "violet"),
        }
        parts.append(
            f'<div class="step-row {state_cls}">'
            f'<div class="step-icon">{icon_map.get(status, "⏳")}</div>'
            f'<span class="step-name">{icon} {_esc(name)}</span>'
            f'<span>{badge_map.get(status, "")}</span>'
            f'<span class="step-dur">{dur_str}</span></div>'
        )
    return '<div class="card">' + "\n".join(parts) + '</div>'


def _log_html(logs: List[Dict[str, str]]) -> str:
    """Render logs as color-coded terminal HTML."""
    if not logs:
        return ""
    lines: List[str] = []
    for entry in logs[-80:]:
        lvl = entry.get("level", "info").lower()
        cls = "log-err" if "err" in lvl else ("log-warn" if "warn" in lvl else "log-info")
        lines.append(f'<div class="{cls}">{_esc(entry.get("msg", ""))}</div>')
    return '<div class="log-term">' + "\n".join(lines) + '</div>'


def _add_log(level: str, msg: str) -> None:
    st.session_state.pipeline_logs.append({"level": level, "msg": msg})


def _set_step(name: str, status: str, duration: float | None = None) -> None:
    st.session_state.pipeline_steps[name] = {"status": status, "duration": duration}


def run_pipeline_with_tracking(
    uploaded_file,
    doc_type: str,
    core_entity: str,
    model_label: str,
    stepper_ph,
    log_ph,
) -> Optional[str]:
    """Run the 5-step pipeline with live UI updates.

    Calls real backend functions from pipeline.* modules.
    Returns path to the saved neo4j-ready JSON, or None on failure.
    """
    model_slug, model_dim, model_dir = _EMBED_MODELS[model_label]

    # Reset state
    for _, name in _PIPELINE_STEPS:
        _set_step(name, "waiting")
    st.session_state.pipeline_logs = []

    def _refresh():
        stepper_ph.markdown(_stepper_html(st.session_state.pipeline_steps), unsafe_allow_html=True)
        log_ph.markdown(_log_html(st.session_state.pipeline_logs), unsafe_allow_html=True)

    _refresh()

    # Save uploaded file to data_lake
    target_dir = DATA_LAKE_RAW / doc_type
    target_dir.mkdir(parents=True, exist_ok=True)
    file_path = target_dir / uploaded_file.name
    file_path.write_bytes(uploaded_file.getbuffer())
    _add_log("info", f"Đã lưu: {file_path}")
    _refresh()

    # ── PARSE ──
    _set_step("PARSE", "running"); _refresh()
    t0 = time.perf_counter()
    try:
        md_text = parse_document(file_path)
        dur = time.perf_counter() - t0
        _set_step("PARSE", "done", dur)
        _add_log("info", f"PARSE → {len(md_text)} ký tự ({dur:.1f}s)")
        st.toast(f"📄 PARSE → {len(md_text)} ký tự", icon="✅")
    except Exception as exc:
        _set_step("PARSE", "error")
        _add_log("error", f"PARSE lỗi: {exc}")
        _refresh(); return None
    _refresh()

    # ── CLEAN ──
    _set_step("CLEAN", "running"); _refresh()
    t0 = time.perf_counter()
    try:
        cleaned = clean_vietnamese_text(md_text)
        dur = time.perf_counter() - t0
        _set_step("CLEAN", "done", dur)
        _add_log("info", f"CLEAN → {len(cleaned)} ký tự ({dur:.1f}s)")
        st.toast(f"🧹 CLEAN → {len(cleaned)} ký tự", icon="✅")
    except Exception as exc:
        _set_step("CLEAN", "error")
        _add_log("error", f"CLEAN lỗi: {exc}")
        _refresh(); return None
    _refresh()

    # ── CHUNK ──
    _set_step("CHUNK", "running"); _refresh()
    t0 = time.perf_counter()
    try:
        chunks = chunk_cleaned_text(cleaned)
        dur = time.perf_counter() - t0
        _set_step("CHUNK", "done", dur)
        _add_log("info", f"CHUNK → {len(chunks)} phân đoạn ({dur:.1f}s)")
        st.toast(f"✂️ CHUNK → {len(chunks)} phân đoạn", icon="✅")
    except Exception as exc:
        _set_step("CHUNK", "error")
        _add_log("error", f"CHUNK lỗi: {exc}")
        _refresh(); return None
    _refresh()

    # Detect core entity
    detected_entity = core_entity.strip() if core_entity else ""
    if not detected_entity:
        detected_entity = _detect_core_entity(cleaned, doc_type)
    if detected_entity:
        _add_log("info", f"Core entity: {detected_entity}")
    _refresh()

    # ── EXTRACT + VECTORIZE (per chunk) ──
    _set_step("EXTRACT", "running"); _refresh()
    t0 = time.perf_counter()
    results: List[Dict[str, Any]] = []
    total_entities = 0
    total_triplets = 0

    for ci, chunk in enumerate(chunks, 1):
        try:
            extraction = extract_knowledge(chunk, core_entity=detected_entity)
            prepared = prepare_for_neo4j(chunk, extraction)
            prepared["source_file"] = uploaded_file.name
            prepared["chunk_index"] = ci
            results.append(prepared)
            total_entities += len(extraction.get("entities", []))
            total_triplets += len(extraction.get("triplets", []))
        except Exception as exc:
            _add_log("warning", f"Chunk {ci}: {exc}")

    dur = time.perf_counter() - t0
    _set_step("EXTRACT", "done", dur)
    _add_log("info", f"EXTRACT → {len(results)} chunks, {total_entities} entities, {total_triplets} triplets ({dur:.1f}s)")
    st.toast(f"🔬 EXTRACT → {total_entities} entities, {total_triplets} triplets", icon="✅")
    _set_step("VECTORIZE", "done", 0.0)
    _add_log("info", f"VECTORIZE → embedding {model_label}")
    st.toast(f"📐 VECTORIZE → {model_label}", icon="✅")
    _refresh()

    if not results:
        _add_log("error", "Không có kết quả nào từ pipeline.")
        _refresh(); return None

    # Save neo4j-ready JSON
    saved_path = save_neo4j_ready(results, uploaded_file.name)
    _add_log("info", f"JSON saved: {saved_path}")
    st.toast(f"💾 JSON saved: {Path(str(saved_path)).name}", icon="✅")
    _refresh()
    return str(saved_path)


def auto_ingest_to_neo4j(json_dir: str, model_slug: str, model_dim: int) -> Dict[str, Any]:
    """Ingest all JSON files in model directory to Neo4j.

    Calls the real Neo4jIngestor.ingest_directory().
    """
    try:
        with Neo4jIngestor() as ingestor:
            stats = ingestor.ingest_directory(
                json_dir,
                embedding_dim=model_dim,
                model_name=model_slug,
            )
        _refresh_neo4j_stats()
        return stats
    except Exception as exc:
        return {"error": str(exc), "files_processed": 0, "chunks_total": 0}


def render_admin_page() -> None:
    """Document ingestion with live pipeline tracker."""
    if not PIPELINE_AVAILABLE:
        st.error("⚠️ Pipeline modules không khả dụng. Kiểm tra cài đặt.")
        return

    col_upload, col_monitor = st.columns([4, 6], gap="large")

    with col_upload:
        st.markdown('<p class="stitle" style="font-size:1.1rem">📤 Tải lên & Cấu hình</p>', unsafe_allow_html=True)

        uploaded_file = st.file_uploader(
            "Tải lên tài liệu",
            type=["pdf", "docx", "doc", "md"],
            key="admin_uploader",
        )

        if uploaded_file:
            ext = uploaded_file.name.rsplit(".", 1)[-1].lower()
            ext_icon = {"pdf": "📕", "docx": "📘", "doc": "📘", "md": "📝"}.get(ext, "📄")
            size_kb = len(uploaded_file.getvalue()) / 1024
            st.markdown(
                f'<div class="card" style="padding:.6rem .8rem;font-size:.85rem">'
                f'{ext_icon} <b>{_esc(uploaded_file.name)}</b>'
                f'<span style="color:var(--text-muted);float:right">{size_kb:.1f} KB</span></div>',
                unsafe_allow_html=True,
            )

        st.markdown("<br>", unsafe_allow_html=True)
        st.markdown("**Phân loại tài liệu**")
        doc_type_label = st.radio(
            "doc_type",
            list(_DOC_TYPES.keys()),
            horizontal=True,
            key="admin_doc_type",
            label_visibility="collapsed",
        )
        doc_type = _DOC_TYPES[doc_type_label]

        core_entity = st.text_input(
            "Chủ thể lõi (tùy chọn)",
            placeholder="Ví dụ: Nguyễn Văn A, Dự án TSC...",
            help="Hệ thống sẽ tự phát hiện nếu để trống.",
        )

        model_label = st.selectbox(
            "Mô hình Embedding",
            list(_EMBED_MODELS.keys()),
            key="admin_embed_model",
        )

        st.markdown("<br>", unsafe_allow_html=True)
        run_clicked = st.button("🚀 Bắt đầu xử lý", use_container_width=True, type="primary")

    with col_monitor:
        st.markdown('<p class="stitle" style="font-size:1.1rem">⚙️ Pipeline Monitor</p>', unsafe_allow_html=True)
        stepper_ph = st.empty()
        log_ph = st.empty()
        summary_ph = st.container()

        # Show current state
        stepper_ph.markdown(_stepper_html(st.session_state.pipeline_steps), unsafe_allow_html=True)
        if st.session_state.pipeline_logs:
            log_ph.markdown(_log_html(st.session_state.pipeline_logs), unsafe_allow_html=True)

    if run_clicked:
        if uploaded_file is None:
            st.error("Vui lòng tải lên ít nhất một tài liệu!")
            return

        t_global = time.perf_counter()

        json_path = run_pipeline_with_tracking(
            uploaded_file, doc_type, core_entity, model_label,
            stepper_ph, log_ph,
        )

        elapsed = time.perf_counter() - t_global

        if json_path:
            model_slug, model_dim, model_dir = _EMBED_MODELS[model_label]
            neo4j_dir = NEO4J_READY_ROOT / model_dir

            if NEO4J_INGESTION_AVAILABLE and neo4j_dir.exists():
                _add_log("info", "Đang nạp vào Neo4j...")
                log_ph.markdown(_log_html(st.session_state.pipeline_logs), unsafe_allow_html=True)

                ingest_stats = auto_ingest_to_neo4j(str(neo4j_dir), model_slug, model_dim)

                if "error" in ingest_stats:
                    _add_log("error", f"Neo4j: {ingest_stats['error']}")
                else:
                    _add_log("info",
                        f"Neo4j: {ingest_stats.get('files_processed', 0)} files, "
                        f"{ingest_stats.get('chunks_total', 0)} chunks")
                log_ph.markdown(_log_html(st.session_state.pipeline_logs), unsafe_allow_html=True)

                with summary_ph:
                    st.markdown("<br>", unsafe_allow_html=True)
                    m1, m2, m3, m4 = st.columns(4)
                    m1.metric("Files", ingest_stats.get("files_processed", 0))
                    m2.metric("Chunks", ingest_stats.get("chunks_total", 0))
                    m3.metric("Failed", ingest_stats.get("files_failed", 0))
                    m4.metric("Thời gian", f"{elapsed:.1f}s")
                    if not ingest_stats.get("error"):
                        st.success(
                            f"✅ Đã nạp {ingest_stats.get('chunks_total', 0)} chunks "
                            f"từ {ingest_stats.get('files_processed', 0)} files vào Neo4j."
                        )
            else:
                _add_log("warning", "Neo4j ingestion module không khả dụng hoặc thư mục chưa tồn tại.")
                log_ph.markdown(_log_html(st.session_state.pipeline_logs), unsafe_allow_html=True)
        else:
            with summary_ph:
                st.error("Pipeline thất bại. Xem log để biết chi tiết.")


# ── MODULE 3: CHAT ────────────────────────────────────────────

def format_answer_with_citations(
    answer: str,
    vec_sources: List[Dict[str, Any]],
    grf_sources: List[Dict[str, Any]],
) -> str:
    """Replace [VEC:…] / [GRF:…] markers with HTML superscripts."""
    cleaned, _ = _extract_citations(answer)
    return cleaned


def _render_assistant_content(msg: Dict[str, Any]) -> None:
    """Render assistant message content inside a st.chat_message context.

    Shows: stats header, formatted answer, source expander, graph detail expander.
    """
    answer = msg.get("answer", msg.get("content", ""))
    vec = msg.get("vec_sources", [])
    grf = msg.get("grf_sources", [])
    elapsed = msg.get("elapsed_ms", 0)
    n_chunks = msg.get("chunks_retrieved", 0)

    # Stats
    st.caption(f"⬡ GraphRAG · {elapsed:.0f}ms · {n_chunks} chunks")

    # Formatted answer with citation superscripts
    formatted = format_answer_with_citations(answer, vec, grf)
    st.markdown(formatted, unsafe_allow_html=True)

    # Sources expander
    if vec or grf:
        with st.expander("📋 Nguồn trích dẫn", expanded=False):
            for i, vs in enumerate(vec, 1):
                score = vs.get("score", 0.0)
                fname = _esc(vs.get("source_file", ""))
                cidx = vs.get("chunk_index", "?")
                st.markdown(
                    f'{i}. {_badge("VEC " + f"{score:.2f}", "cyan")} '
                    f'{fname} · chunk {cidx}',
                    unsafe_allow_html=True,
                )
            for j, gs in enumerate(grf, len(vec) + 1):
                subj = _esc(gs.get("entity", ""))
                rel = _esc(gs.get("relation", ""))
                obj = _esc(gs.get("object", ""))
                st.markdown(
                    f'{j}. {_badge("GRF 1.00", "violet")} '
                    f'{subj} → {rel} → {obj}',
                    unsafe_allow_html=True,
                )

    # Graph triplets detail
    if grf:
        with st.expander("🔗 Chi tiết đồ thị suy luận"):
            for src in grf:
                subj = _esc(src.get("entity", ""))
                rel = _esc(src.get("relation", ""))
                obj = _esc(src.get("object", ""))
                st.markdown(
                    f'<div class="triplet-row">'
                    f'<span class="subj">{subj}</span>'
                    f' ──[<span class="rel">{rel}</span>]──▶ '
                    f'<span class="obj">{obj}</span>'
                    f'</div>',
                    unsafe_allow_html=True,
                )


def render_message(msg: Dict[str, Any]) -> None:
    """Render a single chat message using Streamlit's native chat_message API."""
    if msg["role"] == "user":
        with st.chat_message("user"):
            st.markdown(msg["content"])
    else:
        with st.chat_message("assistant"):
            _render_assistant_content(msg)


def render_chat_page() -> None:
    """Full chat Q&A with hybrid Knowledge Graph search."""
    if not QUERY_ENGINE_AVAILABLE:
        st.error("⚠️ Query engine không khả dụng. Kiểm tra pipeline.hybrid_query_engine.")
        return

    # Top bar
    neo = st.session_state.neo4j_stats
    tc1, tc2, tc3 = st.columns([3, 2, 2])
    with tc1:
        if neo.get("connected"):
            st.markdown(
                f'🔍 **{neo.get("nodes", 0):,}** nodes · **{neo.get("rels", 0):,}** relationships',
            )
        else:
            st.markdown("🔍 Neo4j disconnected")
    with tc2:
        embed_label = st.selectbox(
            "Embedding", list(_EMBED_MODELS.keys()),
            key="chat_embed_model", label_visibility="collapsed",
        )
    with tc3:
        top_k = st.slider("Top-K", 3, 10, 5, key="chat_top_k")

    st.divider()

    # Suggestion chips (rendered BEFORE history so pending_query is set before check)
    suggestions = ["Ai là CTO của công ty?", "Quy trình phê duyệt dự án?", "Kỹ năng của dev team?"]
    chip_cols = st.columns(len(suggestions))
    for i, sug in enumerate(suggestions):
        if chip_cols[i].button(sug, key=f"chip_{i}", use_container_width=True):
            st.session_state.pending_query = sug

    # Render chat history using st.chat_message
    for msg in st.session_state.messages:
        render_message(msg)

    # Chat input
    user_input = st.chat_input("Hỏi về nhân sự, quy trình, dự án...")

    # Determine query source: keyboard input or suggestion chip
    query = user_input
    if not query and st.session_state.get("pending_query"):
        query = st.session_state.pop("pending_query")

    if query:
        # Show the user message immediately
        with st.chat_message("user"):
            st.markdown(query)
        st.session_state.messages.append({"role": "user", "content": query})

        # Process and show assistant response inline (no st.rerun needed)
        model_slug, _, _ = _EMBED_MODELS.get(embed_label, ("phobert_v2", 768, "phobert-v2"))

        with st.chat_message("assistant"):
            error_msg = ""
            with st.spinner("Đang tìm kiếm trong Đồ thị Tri thức..."):
                try:
                    result = hybrid_ask(query, top_k=top_k, model_name=model_slug)
                except Exception as exc:
                    result = None
                    error_msg = str(exc)

            if result:
                records = result.get("records", [])
                elapsed_s = result.get("elapsed", 0)
                assistant_msg: Dict[str, Any] = {
                    "role": "assistant",
                    "answer": result.get("answer", ""),
                    "vec_sources": _build_vec_sources(records),
                    "grf_sources": _build_grf_sources(records),
                    "elapsed_ms": elapsed_s * 1000,
                    "chunks_retrieved": result.get("num_chunks", 0),
                }
            else:
                fallback = (
                    f"Không thể truy vấn: {error_msg}" if error_msg
                    else "Không thể truy vấn. Vui lòng kiểm tra kết nối Neo4j."
                )
                assistant_msg = {
                    "role": "assistant",
                    "answer": fallback,
                    "vec_sources": [],
                    "grf_sources": [],
                    "elapsed_ms": 0,
                    "chunks_retrieved": 0,
                }

            _render_assistant_content(assistant_msg)
            st.session_state.messages.append(assistant_msg)


# ── DISPATCH ──────────────────────────────────────────────────

if role == "admin":
    render_admin_page()
elif role == "user":
    render_chat_page()
else:
    render_guest_page()
